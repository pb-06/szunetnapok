<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" minHeight="600.0" minWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.szunetnapok.SzunetnapokController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label text="Munkaszüneti napok">
      <font>
         <Font name="System Bold" size="24.0" />
      </font></Label>
   <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
      <children>
         <Label text="Adj meg egy évszámot:">
            <font>
               <Font size="14.0" />
            </font>
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Label>
         <Spinner fx:id="spinner_year" editable="true">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Spinner>
          <Button onAction="#onShowButtonClick" text="Keresés" />
      </children>
   </HBox>
</VBox>
